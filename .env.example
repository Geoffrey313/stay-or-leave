# Clés attendues par la chaîne d'acquisition des données brutes.
# Copier en .env.local (ignoré par git) et renseigner. Le dépôt publié
# ne lit AUCUN secret : la reproduction part des données transformées
# déjà livrées dans data/. Ces clés ne servent qu'au ré-approvisionnement.

# OCDE SDMX (Taxing Wages, Pensions at a Glance, PPP, Health) : sans clé.
OECD_SDMX_BASE=https://sdmx.oecd.org/public/rest/data

# Eurostat (indices de prix, prix du logement) : sans clé.
EUROSTAT_BASE=https://ec.europa.eu/eurostat/api/dissemination

# FRED (séries macro US, taux, croissance) : clé gratuite.
FRED_API_KEY=

# Numbeo (coût de la vie, prix au m², loyers par ville) : clé payante.
NUMBEO_API_KEY=
